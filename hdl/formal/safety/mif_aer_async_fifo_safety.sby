# SCPN-MIF-CORE — bounded dual-clock FIFO pointer/payload safety check.

[options]
mode bmc
depth 16
multiclock on

[engines]
smtbmc z3

[script]
read_verilog -sv -formal mif_aer_async_fifo.sv
read_verilog -sv -formal mif_aer_async_fifo_formal.sv
prep -top mif_aer_async_fifo_formal

[files]
../../src/aer/mif_aer_async_fifo.sv
../mif_aer_async_fifo_formal.sv
